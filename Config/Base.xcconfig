// Settings shared by every configuration. Kept here rather than in the project file so that
// they are readable and diff well.
#include "Version.xcconfig"

PRODUCT_NAME = OpenClipboard
PRODUCT_BUNDLE_IDENTIFIER = com.burakgon.OpenClipboard
INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = NO

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
SUPPORTED_PLATFORMS = macosx

SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
COMBINE_HIDPI_IMAGES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_NO_COMMON_BLOCKS = YES
ALWAYS_SEARCH_USER_PATHS = NO

// The public half of the key that signs updates. Sparkle refuses an update that was not
// signed with the matching private key, which is not in this repository.
SPARKLE_PUBLIC_ED_KEY = bD1vjOrgqPG5vaE8e/jPNUIFGyvRHg+Qrg68sjrS0aE=

// Anyone can build and run the app without an Apple developer account: by default it is
// signed ad hoc. To sign with your own identity, which keeps the Accessibility permission
// across rebuilds, create Config/Local.xcconfig (it is ignored by git) with for example:
//
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

#include? "Local.xcconfig"
